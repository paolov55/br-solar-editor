# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel (produção).

# ── Login
AUTH_SECRET=                      # gere com: openssl rand -base64 32
ADMIN_LOGIN=paolovinicios
ADMIN_SENHA=
USUARIO_LOGIN=brenorufino
USUARIO_SENHA=
USUARIO_EMAIL=                    # e-mail do assinante: vai como payer.email no Mercado Pago (em teste, use o e-mail do COMPRADOR de teste)

# ── Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # Project Settings → API → service_role (NUNCA expor no navegador)

# ── Mercado Pago (veja docs/configurar-mercado-pago.md)
MP_ACCESS_TOKEN=                  # token de teste (conta vendedora TESTUSER...) ou de produção; ambos começam com APP_USR-
MP_WEBHOOK_SECRET=                # "assinatura secreta" da tela de Webhooks
APP_URL=http://localhost:3000     # em produção: https://seu-dominio.com (sem barra no final)
